class publication: 
    def __init__(self, title, author):
        self.title = title
        self.author = author
    
    def get_title(self):
        return self.title

    def get_author(self):
        return self.author

    def set_title(self, title):
        self.title = title

    def set_author(self, author):
        self.author = author

    def display_data(self):
        print("Title: ", self.title)
        print("Autor: ", self.author)

